#include <bits/stdc++.h>

using namespace std;

int n, k;
vector<int> v(1, 0), a;

void in(){
	for(int i = 1; i <= k; i++)
	    cout << v[a[i]] << " ";
	cout << endl; 
}  

void Try(int i){
	for(int j = a[i - 1] + 1; j <= n - k + i; j++){
		a[i] = j;
		if(i == k) in();
		else Try(i + 1); 
	} 
}

int main(){
	bool f[1005] = {0};  
	int x;
	cin >> n >> k;
	for(int i = 0; i < n; i++){
		cin >> x;
		if(!f[x]){
			v.push_back(x);
			f[x] = 1;
		}
	} 
	
	sort(v.begin(), v.end());
	n = v.size() - 1;
	a.resize(v.size());
	Try(1); 
} 
