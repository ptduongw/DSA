#include <bits/stdc++.h>

using namespace std;

int n, k;
vector<int> a, tmp;
vector<vector<int>> ans;

void Try(int i, int sum){
	if(sum == k){
		ans.push_back(tmp);
		return;
	}
	for(int j = i; j <= n; j++)
	    if(sum + a[j] <= k){
		    tmp.push_back(a[j]);
		    Try(j + 1, sum + a[j]);
		    tmp.pop_back();
	    } 
}

int main(){
	int t;
	cin >> t;
	
	while(t--){
		cin >> n >> k;
		a.clear();
		for(int i = 1; i <= n; i++) cin >> a[i];
		sort(a.begin(), a.end());
		Try(1, 0);
		if(ans.empty()){
			cout << "-1";
			continue;
		}
		else{
			for(auto &v : ans){
				cout << "[";
			    for(int i = 0; i < v.size(); i++){
			    	cout << v[i];
			        if(i != v.size() - 1) cout << " ";
				}
			        
			    cout << "]";
			}
			
		}
		cout << endl;
	}
}
