#include <bits/stdc++.h>

using  namespace std;

int a[10][10], cot[30] , d1[30] , d2[30] , res = 0;

void Try(int i, int sum){
	if(i == 9){
		res = max(res, sum);
		return; 
	} 
	for(int j = 1; j <= 8; j++){
		if(cot[j] == 0 && d1[i - j + 8] == 0 && d2[i + j] == 0){
			cot[j] = d1[i - j + 8] = d2[i + j] = 1;
		    Try(i + 1, sum + a[i][j]);
			cot[j] = d1[i - j + 8] = d2[i + j] = 0;
		}
	}
}

int main(){
	int t;
	cin >> t;
	for(int k = 1; k <= t; k++){
		res = 0; 
		//for(int i = 1; i <= 9; i++) x[i] = 0; 
		for(int i = 1; i <= 8; i++) 
		    for(int j = 1; j <= 8; j++) 
		        cin >> a[i][j]; 
		Try(1, 0);
		cout << "Test " << k << ": " << res << endl;
	}
}
