#include <bits/stdc++.h>
using namespace std;

char c;
int k;
string s;

void Try(char i) {
    for (char j = i; j <= c; ++j) {
        s.push_back(j);
        if (s.length() == k) cout << s << endl;
        else Try(j);
        s.pop_back();
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL); cout.tie(NULL);

    cin >> c >> k;
    Try('A');
    cout << "\n";
    
    return 0;
}
