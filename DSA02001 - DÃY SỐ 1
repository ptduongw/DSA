#include <bits/stdc++.h>

using namespace std;

int main(){
	int t;
	cin >> t;
	
	while(t--){
		int n;
		cin >> n;
		int a[n + 1];
		
		for(int i = 1; i <= n; i++)
		    cin >> a[i]; 
		cout << "[";
		for(int i = 1; i < n; i++)
			cout << a[i] << " ";
		cout << a[n] << "]" << endl;
		
		while(n > 1){
			for(int i = 1; i < n; i++){
				a[i] = a[i] + a[i + 1];
				if(i == 1) cout << "[" << a[i];
				else cout << " " << a[i];
				if(i == n - 1) cout << "]" << endl;
			}
			n--;
		}
	}
} 
