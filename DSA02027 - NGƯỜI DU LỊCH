#include <bits/stdc++.h>

using  namespace std;

int n, d = 0, ans = 100000, c[25][25], x[20], visited[25];
//x[i] lwu so thu tu thanh pho di qua
void nhap(){
	cin >> n;
	for(int i = 1; i <= n; i++)
	    for(int j = 1; j <= n; j++)
	        cin >> c[i][j];
	//memset(visited, 0, sizeof(visited));
}

void Try(int i){
	for(int j = 2; j <= n; j++){
		if(visited[j] == 0){
			visited[j] = 1;
			x[i] = j;
			d += c[x[i - 1]][j];
			if(i == n){
				ans = min(ans, d + c[j][1]);		
			}
			else Try(i + 1);
		} 
		visited[j] = 0;
		d -= c[x[i - 1]][j];
	}
}

int main(){
	nhap();
	x[1] = 1; visited[1] = 1;
	Try(2);
	cout << ans <<endl;
}
