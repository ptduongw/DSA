#include <iostream>
#include <vector>
#include <queue>

using namespace std;

void BFS(int start, const vector<vector<int> >& adjList, vector<bool>& visited) {
    queue<int> q;
    q.push(start);
    visited[start] = true;

    while (!q.empty()) {
        int u = q.front();
        q.pop();

        cout << u << " " << endl;

        for (int i = 1; i <= u; i++) {
            if (!visited(adjList[i])) {
                q.push(adjList[i]);
                visited[adjList[i]] = true;
            }
        }
    }
}

int main() {
    int V = 5;
    vector<vector<int>> adjList(V);

    adjList[0] = {1, 2};
    adjList[1] = {0, 3};
    adjList[2] = {0, 4};
    adjList[3] = {1};
    adjList[4] = {2};

    vector<bool> visited(V, false);

    int start = 0;
    BFS(start, adjList, visited);

    return 0;
}

