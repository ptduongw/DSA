#include <iostream>
#include <stack>
#include <string>
#include <vector>
#include <cstring>
using namespace std;

bool visited[1001];
vector<int> List[1001];
void DFS(int u){
	cout << u << " ";
	visited[u] = true;
	for(int i = 0; i < List[u].size(); i++){
		int v = List[u][i];
		if(visited[v] == false)
		    DFS(v);
	}
}
int main() {
    int t;
    cin >> t;
    
    while(t--){
    	int n, m, u;
    	cin >> n >> m >> u;
    	
    	memset(visited, false, sizeof(visited));
		for (int i = 0; i < 1001; i++) List[i].clear();
		
    	int a, b;
    	for(int i = 1; i <= m; i++){
    		cin >> a >> b;
    		List[a].push_back(b);
    		List[b].push_back(a);
    		DFS(u);
    		cout << endl;
		}
	}
}

