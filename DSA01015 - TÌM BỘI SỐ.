#include <bits/stdc++.h>
 
using namespace std;

void solve(int n){
	queue<string> q;
	q.push("9");
	
	while(!q.empty()){
		string s = q.front();
		q.pop();
		
		long long num = stoll(s);
		if(num % n == 0){
			cout << s << endl;
			return;
		}
		
		q.push(s + "0");
		q.push(s + "9");
	}
} 


int main(){
	int t;
	cin >> t;
	
	while(t--){
		int n;
		cin >> n;
		solve(n);
	}
}
