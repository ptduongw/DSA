#include <bits/stdc++.h>

using namespace std;
int n, check;
bool a[11][11];
string s = "";

void Solve(int i, int j){
	if(i == n && j == n){
		cout << s << " ";
		check = 1;
		return;
	}
	
	if(a[i + 1][j]){
		s += 'D';
		Solve(i + 1, j);
		s.erase(s.size() - 1, 1);
	}
	
	if(a[i][j + 1]){
		s += 'R';
		Solve(i, j + 1);
		s.erase(s.size() - 1, 1);
	}
}
int main(){
	int t;
	cin >> t;
	while(t--){
		check = 0;
		cin >> n;
		for(int i = 1; i <= n; i++)
		    for(int j = 1; j <= n; j++)
		        cin >> a[i][j];
		        
		if(!a[1][1]) cout << "-1";
        else
        {
            Solve(1, 1);
            if(!check) cout << "-1";
        }
	    cout << endl;
	}
} 
